int numProgramas;
int progInicio[6];
int numExecucao;
int filaProgramas[6];
int progRetomada[6];


void main(void){
    int opcao;
    int escolha;
    int i;
    int pc;
    int base;
    int vivos;

    numProgramas = 5;
    base = 400;

    progInicio[0] = 0;
    output(progInicio[i]);
    i = 1;
    while(i <= numProgramas){
        progInicio[i] = base + ((i-1) * 300);
        output(progInicio[i]);
        i = i + 1;
    }

    while(1){
        
        i = 1;
        output(i);
        opcao = input();

        if(opcao == 1){
            output(numProgramas);
            escolha = input();

            if(escolha >= 0){
                if(escolha <= numProgramas){
                    dispatch(progInicio[escolha]);
                }
            }
        }

        else if(opcao == 2){
            output(numProgramas);
            numExecucao = input();
            if(numExecucao > 0){
                if(numExecucao <= numProgramas){
                    i = 0;
                    while(i < numExecucao){
                        escolha = input();
                        if(escolha > 0){
                            if(escolha <= numProgramas){
                                filaProgramas[i] = progInicio[escolha];
                                i = i + 1;
                            }
                        }
                    }
                    i = 0;
                    while(i < numExecucao){
                        progRetomada[i] = filaProgramas[i];
                        i = i + 1;
                    }
                    vivos = numExecucao;
                    while(vivos > 0){
                        i = 0;
                        while(i < numExecucao){
                            if(progRetomada[i] > 0){ 
                                progRetomada[i] = dispatchClk(filaProgramas[i], progRetomada[i]);
                                if(progRetomada[i] == 0){ 
                                     vivos = vivos - 1;
                                }
                            }
                            i = i + 1;
                        }
                    }
                }
            }
        }

    }
}
