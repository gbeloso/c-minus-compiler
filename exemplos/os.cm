int numProgramas;
int progInicio[4];

void main(void){
    int opcao;
    int escolha;
    int i;

    numProgramas = 3;
    i = 0;
    while(i <= numProgramas){
        progInicio[i] = i * 300;
        output(progInicio[i]);
        i = i + 1;
    }

    while(1){
        i = 1;
        output(i);
        opcao = input();

        if(opcao == 1){
            output(numProgramas);
            escolha = input();

            if(escolha >= 0){
                if(escolha <= numProgramas){
                    dispatch(progInicio[escolha]);
                }
            }
        }
    }
}
